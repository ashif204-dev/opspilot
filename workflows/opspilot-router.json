    {
      "parameters": {
        "jsCode": "const ev = $('Ignore bot messages').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.Setting);\nconst get = (k) => { const r = rows.find(x => x.Setting === k); return r ? String(r.Value).trim() : ''; };\nconst status = get('Bots status').toUpperCase();\nconst admins = get('Admin Slack IDs').split(',').map(s => s.trim()).filter(Boolean);\nconst base = { text: ev.text, user: ev.user, channel: ev.channel, ts: ev.ts, thread_ts: ev.thread_ts };\nconst m = String(ev.text || '').replace(/<@[A-Z0-9]+>/g, '').trim().match(/^(pause|resume)\\s+opspilot$/i);\nif (m) {\n  const cmd = m[1].toLowerCase();\n  if (admins.indexOf(ev.user) >= 0) {\n    return [{ json: Object.assign({}, base, { route: 'update', new_value: cmd === 'pause' ? 'OFF' : 'ON', reply_text: cmd === 'pause' ? ':pause_button: OpsPilot is now *paused*. All bots stay silent until an admin sends \"resume opspilot\".' : ':arrow_forward: OpsPilot is *resumed* and all bots are active again.' }) }];\n  }\n  return [{ json: Object.assign({}, base, { route: 'reply', reply_text: ':lock: Only admins can pause or resume OpsPilot.' }) }];\n}\nif (status !== 'ON') {\n  return [{ json: Object.assign({}, base, { route: 'reply', reply_text: ':pause_button: OpsPilot is paused by an admin right now. Please try again later.' }) }];\n}\nreturn [{ json: Object.assign({}, base, { route: 'run' }) }];"
      },
