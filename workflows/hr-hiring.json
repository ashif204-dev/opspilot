    {
      "parameters": {
        "jsCode": "const q = ($('Called by Router (hiring)').first().json.text || '').toLowerCase();\nconst rows = $input.all().map(i => i.json).filter(r => r.Name);\nlet picked = rows.filter(r => r.Role && q.includes(String(r.Role).toLowerCase()));\nlet scope = picked.length ? 'for ' + picked[0].Role : 'across all roles';\nif (!picked.length) picked = rows;\npicked = picked.slice(-10);\nlet text;\nif (!picked.length) {\n  text = 'No candidates are in the tracker yet.';\n} else {\n  text = '*Hiring status ' + scope + '* (latest ' + picked.length + ')\\n' + picked.map(r => '- ' + r.Name + ' | ' + r.Role + ' | score ' + r.Score + ' | ' + r.Status).join('\\n');\n}\nconst c = $('Called by Router (hiring)').first().json;\nreturn [{ json: { text, channel: c.channel, thread_ts: c.thread_ts } }];"
      },
