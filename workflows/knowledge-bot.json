    {
      "parameters": {
        "jsCode": "const b = $('Build context').first().json;\nconst ans = String($input.first().json.text || '').trim();\nconst cited = Array.from(new Set(Array.from(ans.matchAll(/\\[(\\d+)\\]/g)).map(m => Number(m[1]))));\nconst names = Array.from(new Set(cited.map(n => (b.chunks.find(c => c.n === n) || {}).source).filter(Boolean)));\nconst blocks = [\n  { type: 'section', text: { type: 'mrkdwn', text: ans } },\n  { type: 'context', elements: [{ type: 'mrkdwn', text: ':books: Sources: ' + (names.join(', ') || 'knowledge base') + ' | answered only from indexed company documents' }] }\n];\nreturn [{ json: { blocks: JSON.stringify({ blocks }), sources: names.join(', ') || 'knowledge base' } }];\n"
      },
