      "id": "bf015833-ddf0-4e0b-b9bd-b51da830925f",
      "name": "OpenAI Embeddings (query)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        304,
        336
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const q = $('Called by Router (knowledge)').first().json.text;\nconst items = $input.all().map(i => i.json);\nconst chunks = [];\nitems.forEach((it) => {\n  const d = it.document || it;\n  const text = d.pageContent || '';\n  if (!text.trim()) return;\n  const m = d.metadata || {};\n  chunks.push({ n: chunks.length + 1, source: String(m.source || 'unknown').replace(/\\.[A-Za-z0-9]+$/, ''), text });\n});\nconst context = chunks.map(c => '[' + c.n + '] (source: ' + c.source + ')\\n' + c.text).join('\\n\\n---\\n\\n');\nreturn [{ json: { question: q, context, chunks: chunks.map(c => ({ n: c.n, source: c.source })), hits: chunks.length } }];\n"
      },
      "id": "51188135-a983-4f06-8b42-f9cf64b6e44e",
      "name": "Build context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Question: {{ $json.question }}\n\nContext passages:\n{{ $json.context || \"(no passages found)\" }}",
        "messages": {
          "messageValues": [
            {
              "message": "You answer employee questions using ONLY the numbered context passages provided.\nRules:\n- Every fact you state must come from the passages. Put the passage number in square brackets right after the fact, for example [1] or [2][3].\n- If the passages do not contain the answer, reply with exactly: NO_ANSWER\n- Never use outside knowledge and never guess numbers, dates or limits.\n- If passages conflict, say so briefly and cite both.\n- Be concise: 1 to 4 sentences or a short bullet list. Use Slack mrkdwn (*bold*)."
            }
          ]
        },
        "batching": {}
      },
