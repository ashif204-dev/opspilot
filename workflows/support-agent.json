      "id": "b843e0d1-601a-404d-9ecc-d09a8eefd555",
      "name": "Support intent parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1264,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $('Called by Router (support)').first().json;\nconst d = $('Collect data').first().json;\nconst out = $input.first().json.output || null;\nconst get = (k) => { const r = d.control.find(x => x.Setting === k); return r ? String(r.Value).trim() : ''; };\nconst limit = Number(get('Auto refund limit (USD)')) || 0;\nconst cap = Number(get('Daily auto refund cap (USD)')) || 0;\nconst text = String(t.text || '');\nlet intent = out && out.intent ? String(out.intent) : (/refund|money back/i.test(text) ? 'refund' : (/status|where is|track/i.test(text) ? 'status' : 'other'));\nconst reason = out && out.reason ? String(out.reason) : '';\nconst base = { channel: t.channel, thread_ts: t.thread_ts, user: t.user, intent, reason, limit, cap };\nconst m = text.match(/ORD[-\\s]?(\\d{4})/i);\nif (intent === 'other') return [{ json: Object.assign({}, base, { action: 'info', reply_text: 'I can help with order status and refunds. Please include your order ID, for example: refund ORD-1001.' }) }];\nif (!m) return [{ json: Object.assign({}, base, { action: 'info', reply_text: 'Which order is this about? Please include the order ID, for example ORD-1001.' }) }];\nconst id = 'ORD-' + m[1];\nconst order = d.orders.find(o => o['Order ID'] === id);\nif (!order) return [{ json: Object.assign({}, base, { action: 'info', reply_text: 'I could not find order ' + id + '. Please check the ID.' }) }];\nconst amount = Number(order['Amount USD']);\nconst facts = Object.assign({}, base, { order_id: id, amount, item: order.Item });\nif (intent === 'status') return [{ json: Object.assign({}, facts, { action: 'info', reply_text: ':package: ' + id + ': ' + order.Item + ', $' + amount.toFixed(2) + ', status ' + order.Status + ', refunded: ' + order.Refunded + '.' }) }];\nif (order.Status !== 'Delivered') return [{ json: Object.assign({}, facts, { action: 'info', reply_text: id + ' is ' + order.Status + ' and not delivered yet, so I cannot refund it.' }) }];\nif (String(order.Refunded).toLowerCase() === 'yes') return [{ json: Object.assign({}, facts, { action: 'info', reply_text: id + ' has already been refunded.' }) }];\nconst today = $now.toFormat('yyyy-MM-dd');\nconst autoToday = d.refunds.filter(r => String(r.Time || '').startsWith(today) && String(r['Decided by'] || '').startsWith('policy') && r.Decision === 'Approved').reduce((s, r) => s + (Number(r['Amount USD']) || 0), 0);\nif (amount <= limit && autoToday + amount <= cap) return [{ json: Object.assign({}, facts, { action: 'auto', reply_text: ':white_check_mark: Refund of $' + amount.toFixed(2) + ' approved for ' + id + ' (simulated).' }) }];\nconst why = amount > limit ? 'it is above my $' + limit.toFixed(2) + ' limit' : 'the daily automatic refund cap of $' + cap.toFixed(2) + ' would be exceeded';\nreturn [{ json: Object.assign({}, facts, { action: 'approve', why, reply_text: ':hourglass_flowing_sand: A refund of $' + amount.toFixed(2) + ' for ' + id + ' needs a human approval because ' + why + '. I have asked an approver.' }) }];"
      },
