    {
      "parameters": {
        "jsonSchemaExample": "{ \"parts\": [ { \"text\": \"refund ORD-1004, it arrived broken\", \"intent\": \"support\" }, { \"text\": \"add a task to follow up with the customer about ORD-1004\", \"intent\": \"ops\" } ] }"
      },
      "id": "d20939ed-ecc7-4c67-9ca8-f0be520edb99",
      "name": "Plan parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        352,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $('Called by Router (multi)').first().json;\nconst out = $input.first().json.output || null;\nconst allowed = ['policy', 'hiring', 'ops', 'analytics', 'knowledge', 'support', 'audit'];\nconst names = { policy: 'Policy Brain', hiring: 'HR & Hiring', ops: 'Ops Coordinator', analytics: 'Data Analyst', knowledge: 'Knowledge Bot', support: 'Support Agent', audit: 'Audit Replay', other: 'no bot' };\nconst clean = function (v, n) { return String(v == null ? '' : v).replace(/<[!#@]/g, '< ').replace(/[\\r\\n]+/g, ' ').trim().slice(0, n); };\nlet parts = out && Array.isArray(out.parts) ? out.parts.slice(0, 3) : [];\nparts = parts.map(function (p) { return { text: clean(p && p.text, 300), intent: allowed.indexOf(String(p && p.intent)) >= 0 ? String(p.intent) : 'other' }; }).filter(function (p) { return p.text; });\nlet planned = parts.length > 0;\nif (!planned) { parts = [{ text: clean(t.text, 300), intent: 'other' }]; }\nlet lines = '';\nfor (let i = 0; i < parts.length; i++) { lines += '\\n' + (i + 1) + '. ' + parts[i].text + ' (' + names[parts[i].intent] + ')'; }\nconst plan_text = planned ? ':jigsaw: I read this as ' + parts.length + ' request' + (parts.length === 1 ? '' : 's') + ':' + lines : ':jigsaw: I could not split that message reliably, so I will treat it as one request.';\nreturn [{ json: { channel: t.channel, user: t.user, thread_ts: t.thread_ts, parts: parts, plan_text: plan_text } }];"
      },
      "id": "0690b19d-851f-41d2-a347-1c79a05fa793",
      "name": "Validate plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
