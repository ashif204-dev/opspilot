      "parameters": {
        "jsCode": "const dd = function (a) { const seen = {}; const out = []; for (let i = 0; i < a.length; i++) { const k = JSON.stringify(a[i]); if (!seen[k]) { seen[k] = 1; out.push(a[i]); } } return out; };\nreturn [{ json: { control: dd($('Read control').all().map(i => i.json)), orders: dd($('Read orders').all().map(i => i.json)), refunds: dd($('Read refunds').all().map(i => i.json)) } }];"
      },
