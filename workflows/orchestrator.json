      "id": "0deb478f-023b-4398-b1fb-f551c1b5ed90",
      "name": "OpenAI Chat Model (planner)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        224,
        416
      ],
      "credentials": {
        "openAiApi": {
