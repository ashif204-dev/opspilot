    {
      "parameters": {
        "jsCode": "const today = $today.toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(i => i.json).filter(r => r.Task);\nconst done = rows.filter(r => r.Status === 'Done');\nconst open = rows.filter(r => r.Status !== 'Done');\nconst overdue = open.filter(r => r['Due date'] && r['Due date'] < today);\nconst dueToday = open.filter(r => r['Due date'] === today);\nlet text = ':memo: *Day summary - ' + $today.toFormat('dd LLL yyyy') + '*\\n';\ntext += 'Open: ' + open.length + '  |  Done: ' + done.length + '  |  Overdue: ' + overdue.length + '  |  Due today: ' + dueToday.length + '\\n';\nif (overdue.length) {\n  text += '\\n*Overdue*\\n' + overdue.map(r => '- ' + r.Task + ' (<@' + r['Owner (Slack ID)'] + '>, due ' + r['Due date'] + ')').join('\\n');\n}\nif (dueToday.length) {\n  text += '\\n\\n*Due today*\\n' + dueToday.map(r => '- ' + r.Task + ' (<@' + r['Owner (Slack ID)'] + '>)').join('\\n');\n}\nif (!rows.length) { text = ':memo: *Day summary* - no tasks in the sheet today.'; }\nreturn [{ json: { text, open: open.length, overdue: overdue.length, done: done.length } }];"
      },
