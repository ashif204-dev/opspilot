    {
      "parameters": {
        "jsCode": "const p = $('Validate plan').first().json;\nconst items = [];\nfor (let i = 0; i < p.parts.length; i++) { items.push({ json: { text: p.parts[i].text, intent: p.parts[i].intent, index: i + 1, total: p.parts.length, channel: p.channel, user: p.user, thread_ts: p.thread_ts } }); }\nreturn items;"
      },
