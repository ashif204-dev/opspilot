      "parameters": {
        "jsCode": "const names = $('List policy docs').all();\nconst parts = $input.all().map((item, i) => {\n  const name = names[i] ? names[i].json.name : 'Document ' + (i + 1);\n  return '=== SOURCE: ' + name + ' ===\\n' + (item.json.content || '');\n});\nconst q = $('Called by Router').first().json;\nreturn [{ json: { policies: parts.join('\\n\\n'), question: q.text, user: q.user, channel: q.channel, thread_ts: q.thread_ts } }];"
      },
