      "id": "23cb8e8a-afbb-4714-9a56-0731462f81b3",
      "name": "Read tasks (summary)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        256,
        304
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "kIaJm5ELiobl4u9l",
          "name": "Google Sheets account"
        }
      }
