    {
      "parameters": {
        "jsCode": "const orig = $('Fan out').all();\nconst g = $input.all();\nconst out = [];\nfor (let i = 0; i < orig.length; i++) {\n  const o = orig[i].json;\n  const r = (g[i] && g[i].json) ? g[i].json : {};\n  const verdict = r.verdict || 'error';\n  const ok = verdict === 'allow' || verdict === 'redact';\n  out.push({ json: { text: ok ? (r.clean_text || o.text) : '', intent: o.intent, index: o.index, total: o.total, channel: o.channel, user: o.user, thread_ts: o.thread_ts, verdict: verdict, ok: ok } });\n}\nreturn out;"
      },
